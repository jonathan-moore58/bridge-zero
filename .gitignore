# Secrets: never commit
.env
.env.*
*.account*.json
keystore/

# Build output
node_modules/
out/
cache/
broadcast/*/*/dry-run/
dist/

# Sepolia deployment build (FOUNDRY_PROFILE=sepolia) and an interrupted record write
out-sepolia/
