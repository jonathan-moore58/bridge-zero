# /etc/systemd/system/bz-rollups.service
[Unit]
Description=Bridge Zero rollup relays: one relayer run for Base Sepolia, then one for Arbitrum Sepolia (key bz-relayer), 20 minutes at most each
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bridge-zero/relayer
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.foundry/bin:/usr/local/bin:/usr/bin:/bin
Environment=ESBUILD_WORKER_THREADS=0
# bz-rollups.sh runs Base Sepolia, then Arbitrum Sepolia whatever the first ended with, each ended at
# 20 minutes by timeout (SIGTERM to node and any cast, SIGKILL 30 s later), like the laptop's
# Stop-Process -Force: a crash the next run reconciles from the record. It writes one
# "rollup run <network>: exit <code>" line a run, and the service fails when a run ended with
# anything but 0 (up to date or relayed) or 3 (a transaction still pending).
ExecStart=/home/ubuntu/bz-ops/bz-rollups.sh
# Both runs and their margins; the laptop task's limit was 45 minutes too.
TimeoutStartSec=45min
KillSignal=SIGTERM
TimeoutStopSec=15
# No core file: an abort would write the process's memory into the working directory, the checkout.
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bz-rollups
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
