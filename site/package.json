{
  "name": "@bridge-zero/site",
  "version": "0.1.0",
  "private": true,
  "description": "The Bridge Zero status page: both light clients, the vault and the bridge, read live from the chains; the recorded runs from deployments/ and fixtures/.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test test/abi.test.ts test/scale.test.ts test/records.test.ts test/rpc.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  },
  "overrides": {
    "postcss": "8.5.29",
    "rolldown": "1.2.12"
  }
}
